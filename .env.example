# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
# Keep this enabled for local mobile/LAN testing so Django accepts changing Wi-Fi IPs.
DEV_ALLOW_ALL_HOSTS=True
ALLOWED_HOSTS=*

# Database Configuration (SQLite for development, MySQL for production)
# For SQLite (default):
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# For MySQL (uncomment and configure for production):
# DATABASE_ENGINE=django.db.backends.mysql
# DATABASE_NAME=msosi_faster
# DATABASE_USER=root
# DATABASE_PASSWORD=your_password
# DATABASE_HOST=localhost
# DATABASE_PORT=3306

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=1440  # minutes (1 day)
JWT_REFRESH_TOKEN_LIFETIME=10080  # minutes (7 days)

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ============= PAYMENT GATEWAY CONFIGURATION =============

# Selcom Payment Gateway (M-Pesa, Tigo Pesa, Airtel Money)
# Sign up at: https://selcom.net
# Get your API credentials from your Selcom dashboard
SELCOM_MERCHANT_ID=your_merchant_id
SELCOM_API_KEY=your_selcom_api_key
SELCOM_API_SECRET=your_selcom_api_secret
SELCOM_CALLBACK_URL=http://localhost:8000/api/payments/webhook/selcom/

# For Production, use:
# SELCOM_CALLBACK_URL=https://yourdomain.railway.app/api/payments/webhook/selcom/

# Stripe Payment Gateway (Credit/Debit Cards)
# Sign up at: https://stripe.com
# Get your API keys from your Stripe dashboard
STRIPE_API_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# AzamPay Payment Gateway
# Fill these from your AzamPay dashboard when integration is enabled.
AZAMPAY_APP_NAME=your_azampay_app_name
AZAMPAY_CLIENT_ID=your_azampay_client_id
AZAMPAY_CLIENT_SECRET=your_azampay_client_secret
AZAMPAY_API_KEY=your_azampay_api_key
AZAMPAY_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_CALLBACK_URL=http://localhost:8000/api/payments/webhook/azampay/
